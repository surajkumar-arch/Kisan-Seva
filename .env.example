# ==============================================================================
# KisanSeva Production Environment Configuration Template
# ==============================================================================

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8010
BACKEND_URL=http://localhost:8010
WORKERS=2

# Frontend Configuration
STREAMLIT_PORT=8501
STREAMLIT_ADDRESS=0.0.0.0

# Database Configuration
DATABASE_PATH=data/smart_agriculture.db

# Storage Directories
SOIL_UPLOADS_DIR=backend/uploads/soil
PLANT_UPLOADS_DIR=backend/uploads/plant

# ML Model Evaluation
EVALUATION_OUTPUT_DIR=data/evaluations

# ==============================================================================
# MongoDB Atlas Database Configuration
# ==============================================================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=Setup
MONGODB_DB_NAME=kisanseva

# ==============================================================================
# Cloudinary CDN Image Storage Configuration
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ==============================================================================
# 🌟 Enterprise AI & Third-Party Integrations
# ==============================================================================

# 1. Google Gemini 1.5 Pro / Flash Multilingual Conversational Agronomist
# Get free key from: https://aistudio.google.com/
GEMINI_API_KEY=

# 2. Live Weather & Microclimate Disease Forecasting
# Get free key from: https://openweathermap.org/api or https://www.weatherapi.com/
WEATHER_API_KEY=
WEATHER_PROVIDER=openweather  # Options: openweather, weatherapi

# 3. Sentinel Hub / AgroMonitoring Satellite Remote Sensing (Optional)
# Get key from: https://agromonitoring.com/
AGROMONITORING_API_KEY=

# 4. Indian Mandi Live Market Prices (Data.gov.in) (Optional)
# Get key from: https://data.gov.in/
DATA_GOV_IN_API_KEY=
