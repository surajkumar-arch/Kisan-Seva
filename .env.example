# ==============================================================================
# KisanSeva Production Environment Configuration
# ==============================================================================

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
WORKERS=2

# Frontend Configuration
STREAMLIT_PORT=8501
STREAMLIT_ADDRESS=0.0.0.0

# Database Configuration
DATABASE_PATH=data/smart_agriculture.db

# Storage Directories
SOIL_UPLOADS_DIR=backend/uploads/soil
PLANT_UPLOADS_DIR=backend/uploads/plant

# ML Model Evaluation
EVALUATION_OUTPUT_DIR=data/evaluations

# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=Setup
MONGODB_DB_NAME=kisanseva

# Cloudinary CDN Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
